generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Url {
  id          Int      @id @default(autoincrement())
  shortCode   String   @unique
  originalUrl String
  createdAt   DateTime @default(now())
  clickCount  Int      @default(0)
  customAlias Boolean  @default(false)

  @@index([shortCode])
}
